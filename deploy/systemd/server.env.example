# 复制到 /etc/vulnagent/server.env，权限 0600
VA_ADDR=:8787
VA_DATA_DIR=/var/lib/vulnagent
VA_SESSION_IDLE=30m
# 反向代理终止 TLS 时打开，强制 Secure Cookie
VA_COOKIE_SECURE=1
# 漏洞情报平台密钥（可选）
# VULNAGENT_CVE_API_KEY=
# 自定义情报/EPSS 源（可选）
# VULNAGENT_CVE_BASE_URL=https://cve.imfht.com
# VA_EPSS_URL=https://epss.cyentia.com/epss_scores-current.csv.gz
# 定时复扫
VA_RESCAN_INTERVAL=30m
VA_RESCAN_DEBOUNCE=10m
# 情报定时同步（CVE/POC），设为 0/off 关闭
VA_SYNC_INTERVAL=12h
# 前端产物目录（默认依次探测 ../web/dist、./web/dist、web/dist）
# VA_WEB_DIST=/opt/vulnagent/web/dist
# 生产模式：关闭演示数据，首次启动用强口令初始化唯一管理员
VA_SEED_DEMO=off
# VA_ADMIN_PASSWORD=
# Agent Harness（通用 OpenAI 兼容模型；三项齐备才启用）
# VA_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# VA_LLM_API_KEY=
# VA_LLM_MODEL=deepseek-v4-1-flash-261017
# GPU 推理端点（OpenAI 兼容，如 vLLM；BASE_URL 与 MODEL 齐备即启用，按主机开关生效）
# VA_GPU_LLM_BASE_URL=http://127.0.0.1:8000/v1
# VA_GPU_LLM_API_KEY=local
# VA_GPU_LLM_MODEL=Qwen2.5-32B-Instruct
# Agent/问答上下文 token 预算（4000–128000，默认 16000）
# VA_AGENT_CONTEXT_BUDGET=16000
