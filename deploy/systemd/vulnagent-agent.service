[Unit]
Description=VulnAgent 主机采集与上报（一次性）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/vulnagent/agent.env
# 全局令牌兼容方式；若改用一次性注册，请先运行 --enroll-token 生成身份，
# 再移除 --token-file，让 Agent 读取 VA_AGENT_IDENTITY / 默认身份文件。
ExecStart=/opt/vulnagent/server/vulnagent agent --server ${VA_SERVER} --token-file /etc/vulnagent/agent.token
Nice=10
IOSchedulingClass=idle

# Agent 只读访问包数据库，不写入任何业务数据
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ReadOnlyPaths=/var/lib/dpkg /var/lib/rpm /lib/apk/db /etc
