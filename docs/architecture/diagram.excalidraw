    {
      "id": "t-design-body",
      "type": "text",
      "x": 1204,
      "y": 1324,
      "width": 432,
      "height": 144,
      "backgroundColor": "transparent",
      "strokeColor": "#1D1D1F",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "fontSize": 16,
